# GoalCraft Backend — Environment Configuration
# Copy this file to .env and fill in the values.

# Google Gemini API Key (required for AI features)
GOOGLE_API_KEY="your_google_api_key_here"

# Database connection URL
# For SQLite (local dev):  sqlite:///./goalcraft.db
# For PostgreSQL (prod):   postgresql://user:password@host:5432/goalcraft
DATABASE_URL="sqlite:///./goalcraft.db"

# JWT Authentication
SECRET_KEY="generate_a_strong_random_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Gemini AI Model
GEMINI_MODEL="gemini-3.0-flash"

# CORS allowed origins (comma-separated)
# Use "*" for development, specific origins for production
CORS_ORIGINS="*"

# App environment
ENV="development"
ENABLE_DOCS="true"

# Trusted hosts for production (comma-separated)
ALLOWED_HOSTS="localhost,127.0.0.1"

# CORS credentials toggle
CORS_ALLOW_CREDENTIALS="true"
